# ===========================================================================
# SharePoint file copy -- configuration
# ===========================================================================
# Copy this file to "config.env" in the same folder as the script and fill
# it in.
#
#   copy config.env.example config.env      (Windows)
#   cp   config.env.example config.env      (Linux)
#
# The script looks for these names, in order, next to itself:
#     config.env  ->  config.ini  ->  sp_copy.env
#
# This file is OPTIONAL. The same settings exist as constants in the
# CONFIGURATION section of sp_copy.py and work on their own. Anything set
# here overrides the script; anything left blank leaves the script's value
# alone, so a partly filled file only overrides what it actually sets.
#
# SECURITY
#   config.env holds a live secret. Do NOT commit it (.gitignore already
#   excludes it) and lock the file down:
#     Linux    : chmod 600 config.env
#     Windows  : Properties > Security, restrict to the service account
#
# FORMAT
#   KEY=value        (no spaces around "=", no quotes needed)
#   Lines starting with # are comments. Blank lines are ignored.
#   true/false/yes/no/1/0 work for on-off settings.
# ===========================================================================


# --- Entra ID app registration (SPN) ---------------------------------------
# The three static values your admin gave you when the service principal
# was created:
#
#   Tenant ID      -> SPN_TENANT_ID       (aka Directory ID)
#   Client ID      -> SPN_CLIENT_ID       (aka Application ID)
#   Client Secret  -> SPN_CLIENT_SECRET   (the secret VALUE, not the ID)
#
# NOTE: there is no access token to configure. The script exchanges these
# three for a short-lived Microsoft Graph access token on every run. That
# token lives about an hour and is never stored.
#
# Required Graph APPLICATION permission (admin consented):
#   Sites.ReadWrite.All   -- works everywhere, or
#   Sites.Selected        -- tighter, but needs a one-time per-site grant
#                            on BOTH sites. Run:  python sp_copy.py --grant-help
SPN_TENANT_ID=
SPN_CLIENT_ID=
SPN_CLIENT_SECRET=


# --- Source ----------------------------------------------------------------
# Leave SRC_SITE_ID blank to resolve the site from hostname + path
# automatically. Paste a known site id to skip that lookup.
SRC_SITE_HOSTNAME=mytenant.sharepoint.com
SRC_SITE_PATH=
SRC_SITE_ID=

# Document library. "Documents" is the default library on most sites
# (it appears in the UI as "Shared Documents").
SRC_LIBRARY_NAME=Documents
SRC_DRIVE_ID=

# Path to the file INSIDE that library. No leading slash, no library name.
SRC_FILE_PATH=


# --- Destination -----------------------------------------------------------
DST_SITE_HOSTNAME=mytenant.sharepoint.com
DST_SITE_PATH=
DST_SITE_ID=

DST_LIBRARY_NAME=Documents
DST_DRIVE_ID=

# Folder inside the destination library. Blank = library root. Nested
# paths are fine (Archive/2026); missing folders are created.
DST_FOLDER=

# --- Behaviour -------------------------------------------------------------
# Blank keeps the source filename. Set a name to rename on copy.
NEW_NAME=

# Overwrite a file of the same name at the destination. false makes Graph
# auto-rename instead (report 1.xlsx).
REPLACE_EXISTING=false

# Seconds to wait for the server-side copy before giving up.
COPY_TIMEOUT=300

# Seconds for any single HTTP request.
REQUEST_TIMEOUT=60

# Extra request/response detail on stdout. Turn on to troubleshoot.
DEBUG=false